{
  "bind_address": "127.0.0.1:17443",
  "server_certificate_path": "/etc/openbox-sandbox/tls/server.crt",
  "server_private_key_path": "/etc/openbox-sandbox/tls/server.key",
  "client_ca_path": "/etc/openbox-sandbox/tls/client-ca.crt",
  "authorized_callers": [
    {
      "certificate_sha256": "REPLACE_WITH_RUNTIME_CALLER_CERTIFICATE_SHA256",
      "role": "runtime"
    },
    {
      "certificate_sha256": "REPLACE_WITH_ADMIN_CALLER_CERTIFICATE_SHA256",
      "role": "administrator"
    }
  ],
  "state_directory": "/var/lib/openbox-sandbox/cleanup",
  "asset_bundle": {
    "runtime_contract_version": 1,
    "adapter_build_sha256": "REPLACE_WITH_RUNNING_OPENBOX_SANDBOX_SHA256",
    "template": "registry.example/openbox/sandbox@sha256:REPLACE_WITH_IMAGE_SHA256",
    "policy": {
      "id": "openbox-deny-network",
      "version": 1,
      "sha256": "REPLACE_WITH_POLICY_SHA256"
    },
    "compatibility_id": "docker-sandboxes-v1"
  },
  "runtime_kind": "docker-sandboxes",
  "runtime_connect_timeout_ms": 10000,
  "runtime_poll_interval_ms": 500,
  "reconcile_delete_deadline_ms": 60000,
  "reconcile_wait_deadline_ms": 60000,
  "maximum_connections": 64,
  "drain_timeout_ms": 30000,
  "docker_sandboxes": {
    "sbx_binary": "/usr/local/bin/sbx",
    "workspace": "/var/lib/openbox-sandbox/workspace",
    "template": "registry.example/openbox/sandbox@sha256:REPLACE_WITH_IMAGE_SHA256",
    "policy": {
      "id": "openbox-deny-network",
      "version": 1,
      "sha256": "REPLACE_WITH_POLICY_SHA256"
    },
    "exec_profile": {
      "user": "sandbox",
      "workdir": "/sandbox",
      "readiness_probe": ["/bin/true"]
    }
  }
}
