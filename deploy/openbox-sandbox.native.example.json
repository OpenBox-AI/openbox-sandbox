{
  "bind_address": "127.0.0.1:17443",
  "server_certificate_path": "/etc/openbox-sandbox/tls/server.crt",
  "server_private_key_path": "/etc/openbox-sandbox/tls/server.key",
  "client_ca_path": "/etc/openbox-sandbox/tls/client-ca.crt",
  "authorized_callers": [
    {
      "certificate_sha256": "REPLACE_WITH_RUNTIME_CALLER_CERTIFICATE_SHA256",
      "role": "runtime"
    }
  ],
  "state_directory": "/var/lib/openbox-sandbox/cleanup",
  "provider": "native",
  "provider_capability": "enforced-locally",
  "native_profile_path": "/var/lib/openbox-sandbox/native/policy.sb",
  "native_profile_sha256": "REPLACE_WITH_COMPILED_PROFILE_SHA256",
  "native_workspace_root": "/var/lib/openbox-sandbox/native/workspaces",
  "asset_bundle": {
    "runtime_contract_version": 1,
    "adapter_build_sha256": "REPLACE_WITH_RUNNING_OPENBOX_SANDBOX_SHA256",
    "template": "native://native",
    "policy": {
      "id": "openbox-native-deny-network",
      "version": 1,
      "sha256": "REPLACE_WITH_DEPLOYMENT_POLICY_SHA256"
    },
    "compatibility_id": "native-v1"
  },
  "reconcile_delete_deadline_ms": 60000,
  "reconcile_wait_deadline_ms": 60000,
  "maximum_connections": 64,
  "drain_timeout_ms": 30000
}
